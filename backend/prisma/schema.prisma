generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  createdAt   DateTime @default(now())
}

model Order {
  id         String      @id @default(cuid())
  user       User?       @relation(fields: [userId], references: [id])
  userId     String?
  items      OrderItem[]
  total      Float
  status     String      @default("PENDING")
  createdAt  DateTime    @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
}

model Payment {
  id        String   @id @default(cuid())
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?
  amount    Float
  method    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}
